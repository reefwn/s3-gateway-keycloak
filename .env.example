# Local development only. DevOps supplies real deployment values.
APP_ENVIRONMENT=local
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-local-secret-of-at-least-32-characters
DATABASE_URL=postgres://s3_browser:s3_browser@localhost:5433/s3_browser
KEYCLOAK_ISSUER=https://keycloak.example.test/realms/internal
KEYCLOAK_CLIENT_ID=s3-browser
KEYCLOAK_CLIENT_SECRET=replace-with-local-keycloak-secret
S3_REGION=ap-southeast-7
S3_ALLOWED_BUCKETS=reports,uploads
S3_ROLE_CLAIM=resource_access.s3-browser.roles
S3_ROLE_MAPPING={"s3-browser-admin":"admin","s3-browser-readwrite":"readwrite","s3-browser-readonly":"readonly"}
S3_OBJECT_MAX_BYTES=524288000
S3_TRANSFER_LIMIT=5
S3_ARCHIVE_MAX_OBJECTS=1000
S3_ARCHIVE_MAX_BYTES=2147483648
